{
  "name": "herby-health",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env.local --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env.local server/create-admin.mjs",
    "test:backend": "node --test tests/backend.test.mjs",
    "qa:admin": "node scripts/qa-admin.mjs",
    "emails:preview": "node scripts/preview-emails.mjs",
    "qa:payments": "node scripts/qa-payments-email.mjs",
    "backup": "node --env-file-if-exists=.env.local server/backup.mjs",
    "cf:dev": "wrangler dev --port 8787 --var APP_ORIGIN:http://localhost:8787",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:check": "wrangler deploy --dry-run",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "doctor": "react-doctor . --yes"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "multer": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "react-doctor": "latest",
    "react-grab": "latest",
    "react-scan": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "wrangler": "4.166.0"
  }
}
