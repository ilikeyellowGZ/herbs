{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "herbs",
  "account_id": "693e4791e77341ede9cd47bcb3146ed2",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "APP_ORIGIN": "https://herbs.service-heyywebb.workers.dev" },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "HerbyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HerbyStore"] }],
  "observability": { "enabled": true }
}
