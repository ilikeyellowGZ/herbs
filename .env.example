# Confirmed company Instagram profile, for every Say hello link.
VITE_INSTAGRAM_URL=

# Server settings. Node 24+ is required. Never use VITE_ for server secrets.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5174
DATA_DIR=.local
# Optional first-start owner bootstrap. Prefer npm run admin:create interactively.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain for production.

# Paystack hosted checkout. Server-only keys; never prefix these with VITE_.
# Start with sk_test_...; use sk_live_... only after account activation and tests.
PAYSTACK_SECRET_KEY=
# Modern signing secret (whsec_...) from Paystack API configuration.
# Without it, legacy x-paystack-signature uses PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=

# Resend transactional delivery. EMAIL_FROM must use a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Receives new-order, payment and enquiry alerts; defaults to the store contact/owner email.
NOTIFICATION_EMAIL=
# Resend endpoint signing secret (whsec_...) for delivery/bounce/complaint events.
RESEND_WEBHOOK_SECRET=
