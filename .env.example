# Confirmed company Instagram profile, for every Say hello link.
VITE_INSTAGRAM_URL=

# Server settings. Node 24+ is required. Never use VITE_ for server secrets.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5174
DATA_DIR=.local
# Optional first-start owner bootstrap. Prefer npm run admin:create interactively.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain for production.
